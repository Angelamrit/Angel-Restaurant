# Copy to .env.local for local development. Values here are placeholders only.

# Canonical production URL. Used by metadataBase, sitemap.xml, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.angelindianrestaurant.com

# Resend (https://resend.com) — delivers the private-dining enquiry form.
# CONTACT_FROM_EMAIL must be on a domain verified in the Resend dashboard.
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Angel Website <enquiries@angelindianrestaurantnyc.com>"
CONTACT_TO_EMAIL=angelrestaurant278@gmail.com

# Google Analytics 4 measurement ID (starts with "G-"). Rendered only in production.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional. Timezone for the admin visitor statistics ("today", "this week", the 7-day chart).
# Any IANA name; defaults to the restaurant's own timezone, America/New_York, when unset or invalid.
ANALYTICS_TIMEZONE=

# Google Search Console HTML-tag verification token. Leave unset if the site
# is verified via a DNS TXT record on the domain instead.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# MongoDB Atlas connection URL. Required locally and on Vercel.
# Vercel adds this automatically when the MongoDB Atlas Marketplace integration is connected.
MONGODB_URI=
# Optional database name. Defaults to angel-restaurant when omitted.
MONGODB_DB=angel-restaurant
# Temporary administrator access; at least 32 random characters. Server-only.
ADMIN_ACCESS_KEY=
# Optional. Self-hosting behind your own reverse proxy only: the request header your proxy OVERWRITES with the real
# client address, so rate limits (enquiry form, chat, admin login) apply per visitor instead of to everyone at once.
# nginx: `proxy_set_header X-Real-IP $remote_addr;` with CLIENT_IP_HEADER=x-real-ip. Leave unset on Vercel.
CLIENT_IP_HEADER=
# Optional canonical origin for the shared same-origin check, used by the admin
# CSRF guard and by the public chat endpoint (e.g. https://www.angelindianrestaurant.com).
# Leave unset to compare against the request's own origin.
ADMIN_ORIGIN=
# Public Vercel Blob store for dish images. Server-only write token.
BLOB_READ_WRITE_TOKEN=
# OpenAI chatbot ("Ask Angel"). Server-only; never prefix with NEXT_PUBLIC_.
# Get one from https://platform.openai.com/api-keys. The model is fixed in
# lib/chat/client.ts. Without a key the assistant stays mounted but answers that
# it is unavailable.
OPENAI_API_KEY=
