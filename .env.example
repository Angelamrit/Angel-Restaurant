# Copy to .env.local for local development. Values here are placeholders only.

# Canonical production URL. Used by metadataBase, sitemap.xml, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.angelindianrestaurant.com

# Resend (https://resend.com) — delivers the private-dining enquiry form.
# CONTACT_FROM_EMAIL must be on a domain verified in the Resend dashboard.
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Angel Website <enquiries@angelindianrestaurant.com>"
CONTACT_TO_EMAIL=info@angelindianrestaurant.com

# Google Analytics 4 measurement ID (starts with "G-"). Rendered only in production.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console HTML-tag verification token. Leave unset if the site
# is verified via a DNS TXT record on the domain instead.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# PostgreSQL pooled connection URL. Required on Vercel / production.
DATABASE_URL=
# Temporary administrator access; at least 32 random characters. Server-only.
ADMIN_ACCESS_KEY=
# Optional canonical origin for admin CSRF checks (e.g. https://www.angelindianrestaurant.com).
ADMIN_ORIGIN=
# Public Vercel Blob store for dish images. Server-only write token.
BLOB_READ_WRITE_TOKEN=
# Local development uses SQLite and local uploads when cloud variables are unset.
LOCAL_DATABASE_PATH=.data/angel.sqlite
# Set true ONLY for a local production-build smoke test, never on a deployment.
ALLOW_LOCAL_DATABASE=false
